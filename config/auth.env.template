# Filled by ./setup.sh. Do not commit config/auth.env.

# Public host for Authelia (SWAG server_name)
AUTH_HOST=auth.@DOMAIN@
# Parent domain (used in examples / mail defaults)
DOMAIN=@DOMAIN@

# Shared Docker network with SWAG / tak-home (external)
AUTH_NETWORK=tak

# Admin UI exposure for SWAG snippet (subnet|localhost|tailscale|public)
ADMIN_EXPOSE=subnet

# LLDAP
LLDAP_BASE_DN=dc=@DOMAIN_DC@
LLDAP_ADMIN_PASSWORD=@LLDAP_ADMIN_PASSWORD@
LLDAP_JWT_SECRET=@LLDAP_JWT_SECRET@
# Bind user Authelia uses (created by migrate/bootstrap after first admin login, or set manually)
LLDAP_AUTHELIA_DN=uid=authelia,ou=people,dc=@DOMAIN_DC@
LLDAP_AUTHELIA_PASSWORD=@LLDAP_AUTHELIA_PASSWORD@

# Authelia secrets
AUTHELIA_JWT_SECRET=@AUTHELIA_JWT_SECRET@
AUTHELIA_SESSION_SECRET=@AUTHELIA_SESSION_SECRET@
AUTHELIA_STORAGE_ENCRYPTION_KEY=@AUTHELIA_STORAGE_ENCRYPTION_KEY@
AUTHELIA_OIDC_HMAC_SECRET=@AUTHELIA_OIDC_HMAC_SECRET@

# CloudTAK OIDC client (plaintext secret also goes into CloudTAK Admin)
OIDC_CLOUDTAK_CLIENT_ID=cloudtak
OIDC_CLOUDTAK_CLIENT_SECRET=@OIDC_CLOUDTAK_CLIENT_SECRET@
OIDC_CLOUDTAK_REDIRECT=https://map.@DOMAIN@/api/login/oidc/callback

TZ=UTC
