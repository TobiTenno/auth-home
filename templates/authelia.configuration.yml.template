---
theme: auto
server:
  address: 'tcp://0.0.0.0:9091/'

log:
  level: info

identity_validation:
  reset_password:
    jwt_secret: '{{AUTHELIA_JWT_SECRET}}'

authentication_backend:
  password_reset:
    disable: false
  refresh_interval: '5m'
  ldap:
    implementation: 'lldap'
    address: 'ldap://auth_lldap:3890'
    base_dn: '{{LLDAP_BASE_DN}}'
    user: '{{LLDAP_AUTHELIA_DN}}'
    password: '{{LLDAP_AUTHELIA_PASSWORD}}'

access_control:
  default_policy: 'deny'
  rules:
    - domain: '{{AUTH_HOST}}'
      policy: 'bypass'
      resources:
        - '^/api/.*'
        - '^/\.well-known/.*'
    - domain: '{{AUTH_HOST}}'
      policy: 'two_factor'

session:
  secret: '{{AUTHELIA_SESSION_SECRET}}'
  cookies:
    - name: 'authelia_session'
      domain: '{{DOMAIN}}'
      authelia_url: 'https://{{AUTH_HOST}}'
      # Must differ from authelia_url (Authelia rejects equal values)
      default_redirection_url: 'https://map.{{DOMAIN}}'

storage:
  encryption_key: '{{AUTHELIA_STORAGE_ENCRYPTION_KEY}}'
  local:
    path: '/data/db.sqlite3'

notifier:
  filesystem:
    filename: '/data/notification.txt'

identity_providers:
  oidc:
    hmac_secret: '{{AUTHELIA_OIDC_HMAC_SECRET}}'
    jwks:
      - key_id: 'auth-home'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{OIDC_JWKS_KEY_INDENTED}}
    clients:
      - client_id: '{{OIDC_CLOUDTAK_CLIENT_ID}}'
        client_name: 'CloudTAK'
        client_secret: '{{OIDC_CLOUDTAK_CLIENT_SECRET_HASHED}}'
        public: false
        authorization_policy: 'two_factor'
        redirect_uris:
          - '{{OIDC_CLOUDTAK_REDIRECT}}'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        grant_types:
          - 'authorization_code'
        response_types:
          - 'code'
        token_endpoint_auth_method: 'client_secret_basic'
